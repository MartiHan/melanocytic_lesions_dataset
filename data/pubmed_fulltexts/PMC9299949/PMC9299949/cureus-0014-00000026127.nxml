<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" dtd-version="1.3" xml:lang="en" article-type="review-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Cureus</journal-id><journal-id journal-id-type="iso-abbrev">Cureus</journal-id><journal-id journal-id-type="issn">2168-8184</journal-id><journal-title-group><journal-title>Cureus</journal-title></journal-title-group><issn pub-type="epub">2168-8184</issn><publisher><publisher-name>Cureus</publisher-name><publisher-loc>Palo Alto (CA)</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">35875272</article-id><article-id pub-id-type="pmc">9299949</article-id><article-id pub-id-type="doi">10.7759/cureus.26127</article-id><article-categories><subj-group subj-group-type="heading"><subject>Dermatology</subject></subj-group><subj-group><subject>Medical Education</subject></subj-group><subj-group><subject>Pathology</subject></subj-group></article-categories><title-group><article-title>Recognizing Histopathological Simulators of Melanoma to Avoid Misdiagnosis</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Muacevic</surname><given-names>Alexander</given-names></name></contrib><contrib contrib-type="editor"><name><surname>Adler</surname><given-names>John R</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="author" corresp="yes"><name><surname>Waqar</surname><given-names>Sara</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>George</surname><given-names>Sheeba</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Jean-Baptiste</surname><given-names>Wilford</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Yusuf Ali</surname><given-names>Amina</given-names></name><xref rid="aff-2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Inyang</surname><given-names>Bithaiah</given-names></name><xref rid="aff-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Koshy</surname><given-names>Feeba Sam</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>George</surname><given-names>Kitty</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Poudel</surname><given-names>Prakar</given-names></name><xref rid="aff-4" ref-type="aff">4</xref><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Chalasani</surname><given-names>Roopa</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Goonathilake</surname><given-names>Mastiyage R</given-names></name><xref rid="aff-5" ref-type="aff">5</xref></contrib><contrib contrib-type="author"><name><surname>Mohammed</surname><given-names>Lubna</given-names></name><xref rid="aff-6" ref-type="aff">6</xref></contrib></contrib-group><aff id="aff-1">
